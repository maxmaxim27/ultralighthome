/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Filenames carry a content hash, so these can never go stale.
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Media sits at stable paths, so it gets a bounded lifetime instead: a week in
# the browser, revalidated in the background. Replacing a photo in place takes
# up to that long to reach returning visitors — upload under a new filename when
# the change has to be immediate.
/properties/*
  Cache-Control: public,max-age=604800,stale-while-revalidate=86400

/about/*
  Cache-Control: public,max-age=604800,stale-while-revalidate=86400

/extra/*
  Cache-Control: public,max-age=604800,stale-while-revalidate=86400

/logos/*
  Cache-Control: public,max-age=604800,stale-while-revalidate=86400

/video/*
  Cache-Control: public,max-age=604800,stale-while-revalidate=86400
