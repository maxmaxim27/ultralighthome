{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "ultralighthome",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
    // No "run_worker_first" on purpose. Asset-first is the default: any request
    // matching a file (public/, /_next/static) is answered by the asset binding,
    // which is free, unlimited and applies public/_headers, and the Worker only
    // runs for pages, OG images and /api. A catch-all "/*" turned every image
    // and JS chunk into a billed invocation — about 25 per first page view.
    // Safe because the OpenNext build puts no HTML in .open-next/assets, so no
    // page can skip the i18n middleware.
  }
  // No "images" binding on purpose: next.config.ts sets images.unoptimized, so
  // nothing goes through Cloudflare Images and nothing can bill transformations.
}
