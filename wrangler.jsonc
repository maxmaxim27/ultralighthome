{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Wraps .open-next/worker.js to add byte-range support for /video/*.
  "main": "worker.ts",
  "name": "ultralighthome",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Asset-first is the default: any request matching a file (public/,
    // /_next/static) is answered by the asset binding, which is free, unlimited
    // and applies public/_headers, and the Worker only runs for pages, OG images
    // and /api. A catch-all "/*" once turned every image and JS chunk into a
    // billed invocation — about 25 per first page view. Safe because the
    // OpenNext build puts no HTML in .open-next/assets, so no page can skip the
    // i18n middleware.
    //
    // The one exception is /video/*: the asset binding ignores `Range` and
    // always sends the whole file as a 200, while Safari streams video through
    // 206 responses. worker.ts answers those ranges, at the cost of a few
    // invocations per visit.
    "run_worker_first": ["/video/*"]
  }
  // No "images" binding on purpose: next.config.ts sets images.unoptimized, so
  // nothing goes through Cloudflare Images and nothing can bill transformations.
}
