{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ultralighthome",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    // The static export of the whole site (`npm run build`). Requests that
    // match a file here are answered by the asset layer, which is free, does
    // not count against the Worker's CPU limit, and applies out/_headers and
    // out/_redirects.
    "directory": "./out",
    "binding": "ASSETS",
    // A URL with no file gets the nearest 404.html with status 404: /en/x gets
    // out/en/404.html, /x the Italian out/404.html. No Worker involved.
    "not_found_handling": "404-page",
    // The only paths that run code:
    //   /         picks the visitor's language (worker/home.ts);
    //   /api/*    the contact form (worker/contact.ts);
    //   /video/*  byte ranges, which the asset layer ignores and Safari needs
    //             to play the hero video (worker/video.ts).
    // "/" matches the home page alone, not every path.
    "run_worker_first": ["/", "/api/*", "/video/*"]
  }
}
